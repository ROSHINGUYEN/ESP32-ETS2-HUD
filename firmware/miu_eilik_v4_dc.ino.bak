// =================== SECTION 2: CẤU HÌNH PHẦN CỨNG ===================
// OLED SSD1306
#define PIN_OLED_SDA             8
#define PIN_OLED_SCL             9
#define OLED_ADDR                0x3C
#define SCREEN_W                 128
#define SCREEN_H                 64
#define OLED_I2C_CLOCK_HZ        800000UL

// 2 DC Motor SG90 + H-Bridge (TB6612FNG / L298N)
#define PIN_MOTOR_PAN_IN1        4    // AI1
#define PIN_MOTOR_PAN_IN2        5    // AI2
#define PIN_MOTOR_PAN_PWM        6    // PWMA
#define PIN_MOTOR_TILT_IN1       15   // BI1
#define PIN_MOTOR_TILT_IN2       16   // BI2
#define PIN_MOTOR_TILT_PWM       17   // PWMB

// PWM
#define MOTOR_PWM_CH_PAN         0
#define MOTOR_PWM_CH_TILT        1
#define MOTOR_PWM_FREQ_HZ        25000UL
#define MOTOR_PWM_RES_BITS       8
#define MOTOR_PWM_MAX            255
#define MOTOR_PWM_DEADZONE       24
#define MOTOR_PWM_DEFAULT        140
#define MOTOR_IDLE_STOP_MS       600

// Góc (độ)
#define PAN_MIN_DEG              40.0f
#define PAN_MAX_DEG              140.0f
#define PAN_CENTER_DEG           90.0f
#define TILT_MIN_DEG             70.0f
#define TILT_MAX_DEG             115.0f
#define TILT_CENTER_DEG          90.0f

// WiFi
#define WIFI_AP_SSID             "EILIK_ROBOT"
#define WIFI_AP_PASS             "12345678"
#define WIFI_AP_CHANNEL          6

// Firmware
#define FIRMWARE_VERSION         "4.0.0-clean"
#define FIRMWARE_BUILD_TIME      __DATE__ " " __TIME__

// =================== SECTION 3: ENUMS ===================
enum GestureId : uint8_t {
  GESTURE_NONE = 0,
  GESTURE_NOD_YES,
  GESTURE_SHAKE_NO,
  GESTURE_TILT_CURIOUS,
  GESTURE_SLEEP_DROOP,
  GESTURE_WAKE_STRETCH,
  GESTURE_BOUNCE_HAPPY,
};

enum EmotionType : uint8_t {
  EMOTION_NEUTRAL = 0,
  EMOTION_HAPPY,
  EMOTION_SLEEPY,
  EMOTION_CURIOUS,
  EMOTION_CONFUSED,
  EMOTION_WAKE_UP,
};

enum AutonomyMode : uint8_t {
  AUTO_MODE_SLEEP = 0,
  AUTO_MODE_CALM,
  AUTO_MODE_CURIOUS,
  AUTO_MODE_PLAYFUL,
  AUTO_MODE_AI_LITE,    // <-- AI nhẹ mới: phản ứng theo thời gian + bias
};

enum AiPersonality : uint8_t {
  AI_PERSONALITY_SHY = 0,    // ít chuyển động, tò mò ngắn
  AI_PERSONALITY_PLAYFUL,    // năng động, gesture nhiều
  AI_PERSONALITY_CHILL,      // thở đều, chậm rãi
};

enum OtaState : uint8_t { OTA_IDLE = 0, OTA_CHECKING, OTA_DOWNLOADING, OTA_FLASHING, OTA_DONE, OTA_ERROR };

struct Keyframe { float pan, tilt; uint16_t ms; };

struct OtaProgress {
  OtaState state = OTA_IDLE;
  size_t   received = 0;
  size_t   total    = 0;
  uint8_t  percent  = 0;
  String   status   = "idle";
  String   error;
};

// =================== SECTION 4: GLOBALS ===================
// Mutex chia sẻ dữ liệu giữa 2 core
static SemaphoreHandle_t gStateMutex = nullptr;

// Web server
WebServer   serverObj(80);
DNSServer   dnsServerObj;

// OLED
Adafruit_SSD1306 displayObj(SCREEN_W, SCREEN_H, &Wire, -1);
RoboEyes<Adafruit_SSD1306> *pRoboEyes = nullptr;

// OTA
OtaProgress gOta;
String      gOtaUrl;
TaskHandle_t gOtaTaskHandle = nullptr;

// =================== SECTION 5: HEAD MOTION (2 DC MOTOR) ===================
struct DcAxis {
  int8_t   currentDir = 0;       // -1, 0, +1
  uint8_t  currentPwm = 0;       // 0..255
  float    currentAngle = 90.0f; // mô phỏng
  float    targetAngle  = 90.0f;
  int8_t   offset       = 0;     // calibration
  float    minLimit, maxLimit;
  unsigned long lastCmdMs = 0;
};

class HeadMotionController {
public:
  DcAxis axisPan, axisTilt;
  bool   autoTargetActive = false;
  unsigned long lastMoveMs = 0;

  void begin() {
    axisPan.minLimit  = PAN_MIN_DEG;  axisPan.maxLimit  = PAN_MAX_DEG;
    axisTilt.minLimit = TILT_MIN_DEG; axisTilt.maxLimit = TILT_MAX_DEG;
    axisPan.currentAngle  = axisPan.targetAngle  = PAN_CENTER_DEG;
    axisTilt.currentAngle = axisTilt.targetAngle = TILT_CENTER_DEG;

    pinMode(PIN_MOTOR_PAN_IN1,  OUTPUT);
    pinMode(PIN_MOTOR_PAN_IN2,  OUTPUT);
    pinMode(PIN_MOTOR_TILT_IN1, OUTPUT);
    pinMode(PIN_MOTOR_TILT_IN2, OUTPUT);

    ledcSetup(MOTOR_PWM_CH_PAN,  MOTOR_PWM_FREQ_HZ, MOTOR_PWM_RES_BITS);
    ledcSetup(MOTOR_PWM_CH_TILT, MOTOR_PWM_FREQ_HZ, MOTOR_PWM_RES_BITS);
    ledcAttachPin(PIN_MOTOR_PAN_PWM,  MOTOR_PWM_CH_PAN);
    ledcAttachPin(PIN_MOTOR_TILT_PWM, MOTOR_PWM_CH_TILT);

    stopAll();
    Serial0.println(F("[MOTOR] H-Bridge init OK (PAN + TILT)."));
  }

  /** Joystick analog liên tục (web). axis 0=PAN, 1=TILT. v: -100..100 */
  void joystick(uint8_t axis, int8_t v) {
    autoTargetActive = false;
    DcAxis &a = (axis == 0) ? axisPan : axisTilt;
    a.lastCmdMs = millis();
    if (abs(v) < 8) { a.currentDir = 0; a.currentPwm = 0; applyMotor(axis); return; }
    a.currentDir = (v > 0) ? +1 : -1;
    uint8_t mag = (uint8_t)constrain(abs(v), 0, 100);
    a.currentPwm = MOTOR_PWM_DEADZONE + (uint8_t)((MOTOR_PWM_MAX - MOTOR_PWM_DEADZONE) * mag / 100);
    applyMotor(axis);
  }

  /** Set target góc - motor tự chạy tới đích (dùng cho gesture/AI) */
  void setTarget(float p, float t) {
    axisPan.targetAngle  = constrain(p, PAN_MIN_DEG,  PAN_MAX_DEG);
    axisTilt.targetAngle = constrain(t, TILT_MIN_DEG, TILT_MAX_DEG);
    autoTargetActive     = true;
    lastMoveMs           = millis();
  }

  void center() { setTarget(PAN_CENTER_DEG, TILT_CENTER_DEG); }

  void stopAll() {
    axisPan.currentDir  = axisTilt.currentDir  = 0;
    axisPan.currentPwm  = axisTilt.currentPwm  = 0;
    applyMotor(0); applyMotor(1);
  }

  bool isMoving() const { return (axisPan.currentPwm > 0) || (axisTilt.currentPwm > 0); }

  void update(float dtSec) {
    integrateAxis(axisPan,  dtSec);
    integrateAxis(axisTilt, dtSec);
    unsigned long now = millis();

    if (autoTargetActive) {
      // Drive both axes toward target
      driveTowards(axisPan,  0);
      driveTowards(axisTilt, 1);
      bool reached = (fabs(axisPan.targetAngle  - axisPan.currentAngle)  < 1.0f)
                  && (fabs(axisTilt.targetAngle - axisTilt.currentAngle) < 1.0f);
      if (reached) { autoTargetActive = false; stopAll(); }
    } else {
      // Auto-stop khi joystick im lặng
      if ((now - axisPan.lastCmdMs  > MOTOR_IDLE_STOP_MS) && axisPan.currentDir  != 0) { axisPan.currentDir  = 0; axisPan.currentPwm  = 0; applyMotor(0); }
      if ((now - axisTilt.lastCmdMs > MOTOR_IDLE_STOP_MS) && axisTilt.currentDir != 0) { axisTilt.currentDir = 0; axisTilt.currentPwm = 0; applyMotor(1); }
    }
  }

  void saveOffsets(int8_t p, int8_t t) {
    axisPan.offset = p; axisTilt.offset = t;
    Preferences pf; pf.begin("eilik_calib", false);
    pf.putChar("pan", p); pf.putChar("tilt", t); pf.end();
  }

  void loadOffsets() {
    Preferences pf; pf.begin("eilik_calib", true);
    axisPan.offset  = pf.getChar("pan",  0);
    axisTilt.offset = pf.getChar("tilt", 0);
    pf.end();
  }

private:
  void integrateAxis(DcAxis &a, float dt) {
    if (a.currentPwm == 0) return;
    float maxDps = 90.0f; // tốc độ ước lượng
    float angSpeed = (a.currentPwm / 255.0f) * maxDps;
    a.currentAngle += a.currentDir * angSpeed * dt;
    a.currentAngle = constrain(a.currentAngle, a.minLimit, a.maxLimit);
  }

  void driveTowards(DcAxis &a, uint8_t id) {
    float err = a.targetAngle - a.currentAngle;
    if (fabs(err) < 1.0f) { a.currentDir = 0; a.currentPwm = 0; applyMotor(id); return; }
    a.currentDir = (err > 0) ? +1 : -1;
    a.currentPwm = MOTOR_PWM_DEFAULT;
    a.lastCmdMs  = millis();
    applyMotor(id);
  }

  void applyMotor(uint8_t id) {
    int in1, in2, ch;
    DcAxis &a = (id == 0) ? axisPan : axisTilt;
    if (id == 0) { in1 = PIN_MOTOR_PAN_IN1; in2 = PIN_MOTOR_PAN_IN2; ch = MOTOR_PWM_CH_PAN; }
    else         { in1 = PIN_MOTOR_TILT_IN1; in2 = PIN_MOTOR_TILT_IN2; ch = MOTOR_PWM_CH_TILT; }
    if      (a.currentDir > 0) { digitalWrite(in1, HIGH); digitalWrite(in2, LOW);  }
    else if (a.currentDir < 0) { digitalWrite(in1, LOW);  digitalWrite(in2, HIGH); }
    else                       { digitalWrite(in1, LOW);  digitalWrite(in2, LOW);  }
    ledcWrite(ch, a.currentPwm);
  }
} head;

// =================== SECTION 6: GESTURE PLAYER ===================
static const Keyframe TRACK_NOD_YES[]      = { {90,106,160},{90,82,160},{90,104,140},{90,86,140},{90,90,180} };
static const Keyframe TRACK_SHAKE_NO[]     = { {115,90,150},{65,90,200},{110,90,180},{70,90,180},{90,90,180} };
static const Keyframe TRACK_TILT_CURIOUS[] = { {106,80,350},{106,80,800},{90,90,350} };
static const Keyframe TRACK_SLEEP_DROOP[]  = { {90,96,400},{90,106,600},{90,114,800} };
static const Keyframe TRACK_WAKE_STRETCH[] = { {80,105,350},{90,76,500},{100,76,250},{90,90,350} };
static const Keyframe TRACK_BOUNCE_HAPPY[] = { {90,102,110},{90,86,120},{90,102,110},{90,90,150} };

class GesturePlayer {
public:
  GestureId currentGesture = GESTURE_NONE;
  bool isPlaying = false;
  bool breathingEnabled = true;
  const Keyframe* currentTrack = nullptr;
  uint8_t trackLen = 0, frameIdx = 0;
  unsigned long frameStartMs = 0;

  void play(GestureId id) {
    currentGesture = id; frameIdx = 0;
    switch (id) {
      case GESTURE_NOD_YES:      currentTrack = TRACK_NOD_YES;      trackLen = 5; break;
      case GESTURE_SHAKE_NO:     currentTrack = TRACK_SHAKE_NO;     trackLen = 5; break;
      case GESTURE_TILT_CURIOUS: currentTrack = TRACK_TILT_CURIOUS; trackLen = 3; break;
      case GESTURE_SLEEP_DROOP:  currentTrack = TRACK_SLEEP_DROOP;  trackLen = 3; break;
      case GESTURE_WAKE_STRETCH: currentTrack = TRACK_WAKE_STRETCH; trackLen = 4; break;
      case GESTURE_BOUNCE_HAPPY: currentTrack = TRACK_BOUNCE_HAPPY; trackLen = 4; break;
      default: isPlaying = false; return;
    }
    isPlaying = true; startFrame(0);
  }

  void startFrame(uint8_t i) {
    frameIdx = i; frameStartMs = millis();
    const Keyframe &kf = currentTrack[i];
    head.setTarget(kf.pan, kf.tilt);
  }

  void update() {
    if (isPlaying && currentTrack) {
      if (millis() - frameStartMs >= currentTrack[frameIdx].ms) {
        if (frameIdx + 1 < trackLen) startFrame(frameIdx + 1);
        else { isPlaying = false; currentGesture = GESTURE_NONE; }
      }
      return;
    }
    // Thở tự nhiên khi idle
    if (breathingEnabled && !head.isMoving()) {
      float b = sin((float)millis() * 2.0f * PI / 4200.0f) * 1.5f;
      head.setTarget(PAN_CENTER_DEG, TILT_CENTER_DEG + b);
    }
  }
} gesture;

// =================== SECTION 7: AI LITE (TỰ HÀNH PHẢN ỨNG) ===================
/**
 * AI nhẹ - không cần model, chỉ là state machine theo dõi:
 *  - Thời gian idle (user không điều khiển)
 *  - "Tâm trạng" thay đổi theo tick ngẫu nhiên có trọng số
 *  - "Cá tính" điều chỉnh tần suất/biên độ chuyển động
 *  - Phản ứng theo event: vừa kết nối, vừa bị joystick thả, mới wake up
 */
class AiLite {
public:
  AutonomyMode  mode        = AUTO_MODE_AI_LITE;
  AiPersonality personality = AI_PERSONALITY_PLAYFUL;

  // State máy
  float    mood        = 0.5f;  // 0..1 (0=buồn, 1=vui)
  uint8_t  energy      = 60;    // 0..100
  unsigned long lastActionMs = 0;
  unsigned long nextActionDelayMs = 3000;
  uint8_t  reactionCounter = 0;  // gesture hàng chờ
  GestureId pendingGesture = GESTURE_NONE;

  // Lịch sử tương tác
  unsigned long lastUserInputMs = 0;
  uint8_t  userInputCount  = 0;
  bool     userJustLeft    = false;

  void notifyUserInput() {
    userJustLeft   = false;
    userInputCount = (uint8_t)min(255, (int)userInputCount + 1);
    lastUserInputMs = millis();
    // Mood tăng khi user tương tác
    mood = min(1.0f, mood + 0.05f);
  }

  void tick() {
    if (mode != AUTO_MODE_AI_LITE) return;
    if (gesture.isPlaying || head.isMoving()) return;

    // User vừa thả joystick -> khoảnh khắc dễ thương
    if (userInputCount > 0 && (millis() - lastUserInputMs) > 1200 && !userJustLeft) {
      userJustLeft = true;
      // Gesture "tilt curious" nhẹ nhàng để phản ứng
      pendingGesture = GESTURE_TILT_CURIOUS;
    }

    // Mood tự rớt theo thời gian (nếu user không tương tác)
    if (millis() - lastUserInputMs > 8000) {
      mood = max(0.0f, mood - 0.0005f);  // rất chậm
    }

    if (millis() - lastActionMs < nextActionDelayMs) return;
    lastActionMs = millis();

    // Trọng số hành vi theo personality
    int pShy = 0, pPlay = 0, pChill = 0;
    if (personality == AI_PERSONALITY_SHY)     { pShy = 50; pPlay = 10; pChill = 40; }
    else if (personality == AI_PERSONALITY_CHILL) { pShy = 10; pPlay = 10; pChill = 80; }
    else                                          { pShy = 15; pPlay = 70; pChill = 15; } // PLAYFUL

    // Mood điều chỉnh
    if (mood < 0.3f) pChill += 40;
    else if (mood > 0.7f) pPlay += 30;

    int r = random(0, 100);
    int action = 0; // 0=chill, 1=playful, 2=shy-tilt
    if (r < pChill) action = 0;
    else if (r < pChill + pPlay) action = 1;
    else action = 2;

    // Biên độ theo personality
    int tiltAmp = (personality == AI_PERSONALITY_PLAYFUL) ? 15 : (personality == AI_PERSONALITY_SHY) ? 6 : 10;
    int panAmp  = (personality == AI_PERSONALITY_PLAYFUL) ? 30 : (personality == AI_PERSONALITY_SHY) ? 10 : 18;

    float p = PAN_CENTER_DEG  + (random(-panAmp,  panAmp+1));
    float t = TILT_CENTER_DEG + (random(-tiltAmp, tiltAmp+1));
    p = constrain(p, PAN_MIN_DEG, PAN_MAX_DEG);
    t = constrain(t, TILT_MIN_DEG, TILT_MAX_DEG);

    if (action == 1) {
      // Vui -> gesture
      pendingGesture = (random(0, 2) == 0) ? GESTURE_BOUNCE_HAPPY : GESTURE_NOD_YES;
    } else if (action == 2) {
      pendingGesture = GESTURE_TILT_CURIOUS;
    } else {
      head.setTarget(p, t);
    }

    // Lên lịch lần sau
    int baseDelay = (personality == AI_PERSONALITY_PLAYFUL) ? 2500
                  : (personality == AI_PERSONALITY_SHY)     ? 6000
                  :                                          4000;
    nextActionDelayMs = baseDelay + random(0, 3000);
  }

  /** Gọi mỗi loop để dispatch gesture đã chờ */
  void dispatch() {
    if (pendingGesture != GESTURE_NONE) {
      gesture.play(pendingGesture);
      pendingGesture = GESTURE_NONE;
    }
  }

  void setMode(AutonomyMode m) { mode = m; lastActionMs = millis(); }
  void setPersonality(AiPersonality p) { personality = p; }
} ai;

// =================== SECTION 8: OLED DISPLAY ===================
class DisplayTask {
public:
  unsigned long lastFrameMs = 0;
  float actualFps = 30;
  uint16_t frameCount = 0;
  unsigned long fpsTimerMs = 0;

  void begin() {
    Wire.begin(PIN_OLED_SDA, PIN_OLED_SCL);
    Wire.setClock(OLED_I2C_CLOCK_HZ);
    displayObj.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR);
    displayObj.clearDisplay(); displayObj.display();
    pRoboEyes = new RoboEyes<Adafruit_SSD1306>(displayObj);
    pRoboEyes->begin(SCREEN_W, SCREEN_H, 30);
    pRoboEyes->setAutoblinker(ON, 3, 2);
    pRoboEyes->setIdleMode(ON, 2, 2);
    pRoboEyes->setMood(DEFAULT);
  }

  void update() {
    unsigned long now = millis();
    if (now - lastFrameMs < 33) return; // 30 FPS
    lastFrameMs = now;
    frameCount++;
    if (now - fpsTimerMs >= 1000) { actualFps = frameCount; frameCount = 0; fpsTimerMs = now; }
    if (pRoboEyes) pRoboEyes->update();
  }
} display;

// =================== SECTION 9: AUTONOMY (mode SLEEP/CALM/CURIOUS/PLAYFUL) ===================
class Autonomy {
public:
  AutonomyMode mode = AUTO_MODE_CALM;
  unsigned long manualUntilMs = 0;
  unsigned long lastActionMs  = 0;
  uint16_t     actionDelayMs  = 4000;

  void notifyManual() { manualUntilMs = millis() + 8000; }
  bool isManual() const { return (int32_t)(millis() - manualUntilMs) < 0; }

  void setMode(AutonomyMode m) {
    mode = m;
    if (m == AUTO_MODE_SLEEP) {
      // Không cần mắt mở -> có thể sleep gesture
    }
  }

  void update() {
    if (isManual()) return;
    if (gesture.isPlaying) return;
    if (mode == AUTO_MODE_SLEEP) {
      if (millis() - lastActionMs > 30000) { lastActionMs = millis(); gesture.play(GESTURE_SLEEP_DROOP); }
      return;
    }
    if (ai.mode == AUTO_MODE_AI_LITE) return; // AI đã lo
    if (millis() - lastActionMs < actionDelayMs) return;
    lastActionMs = millis();
    actionDelayMs = random(4000, 8000);
    if      (mode == AUTO_MODE_CURIOUS) { if (random(2)) head.setTarget(random(70, 111), random(80, 101)); else gesture.play(GESTURE_TILT_CURIOUS); }
    else if (mode == AUTO_MODE_PLAYFUL) { gesture.play(GESTURE_BOUNCE_HAPPY); }
  }
} autonomy;

// =================== SECTION 10: OTA TASK ===================
/**
 * Tải firmware từ URL, ghi vào Update partition.
 * Gọi ESP.restart() sau khi flash xong.
 */
void otaTaskFn(void *param) {
  while (true) {
    // Đợi notify
    ulTaskNotifyTake(pdTRUE, portMAX_DELAY);

    if (gOtaUrl.length() < 8) {
      gOta.state = OTA_ERROR; gOta.error = "invalid url";
      continue;
    }

    Serial0.printf("[OTA] Start download: %s\n", gOtaUrl.c_str());

    HTTPClient http;
    http.begin(gOtaUrl);
    http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
    int code = http.GET();

    if (code != HTTP_CODE_OK) {
      gOta.state = OTA_ERROR; gOta.error = "HTTP " + String(code);
      http.end();
      Serial0.printf("[OTA] FAIL: %s\n", gOta.error.c_str());
      continue;
    }

    int total = http.getSize();
    if (total <= 0) total = UPDATE_SIZE_UNKNOWN;

    if (!Update.begin(total)) {
      gOta.state = OTA_ERROR; gOta.error = "Update.begin fail";
      http.end();
      continue;
    }

    gOta.state    = OTA_DOWNLOADING;
    gOta.total    = (size_t)total;
    gOta.received = 0; gOta.percent = 0;
    gOta.status   = "downloading";

    WiFiClient *stream = http.getStreamPtr();
    uint8_t buf[1024];
    size_t readBytes = 0;
    unsigned long lastReport = 0;

    while (http.connected() && (readBytes = stream->readBytes(buf, sizeof(buf))) > 0) {
      if (Update.write(buf, readBytes) != readBytes) {
        gOta.state = OTA_ERROR; gOta.error = "Update.write fail";
        Update.abort();
        break;
      }
      gOta.received += readBytes;
      if (gOta.total > 0) gOta.percent = (uint8_t)(gOta.received * 100UL / gOta.total);

      if (millis() - lastReport > 200) {
        lastReport = millis();
        gOta.status = String("downloading ") + String(gOta.percent) + "%";
      }
    }

    if (gOta.state == OTA_ERROR) { http.end(); continue; }

    if (Update.end(true)) {
      gOta.state = OTA_DONE; gOta.percent = 100; gOta.status = "done - rebooting";
      Serial0.printf("[OTA] OK: %u bytes\n", gOta.received);
      http.end();
      vTaskDelay(pdMS_TO_TICKS(500));
      ESP.restart();
    } else {
      gOta.state = OTA_ERROR; gOta.error = "Update.end fail";
      Update.printError(Serial0);
    }
    http.end();
  }
}

// =================== SECTION 11: WEB SERVER ===================
/** Helper: gửi file LittleFS với MIME đúng */
bool serveFsFile(const String& path, const String& contentType) {
  if (!LittleFS.exists(path)) return false;
  File f = LittleFS.open(path, "r");
  if (!f) return false;
  serverObj.streamFile(f, contentType);
  f.close();
  return true;
}

void sendOtaJson() {
  JsonDocument d;
  d["state"]   = (int)gOta.state;
  d["status"]  = gOta.status;
  d["percent"] = gOta.percent;
  d["received"]= gOta.received;
  d["total"]   = gOta.total;
  d["error"]   = gOta.error;
  String s; serializeJson(d, s);
  serverObj.send(200, "application/json", s);
}

void setupWebServer() {
  WiFi.mode(WIFI_AP);
  WiFi.softAP(WIFI_AP_SSID, WIFI_AP_PASS, WIFI_AP_CHANNEL, 0, 4);
  dnsServerObj.start(53, "*", WiFi.softAPIP());

  // ----- Trang web tĩnh (LittleFS) -----
  serverObj.on("/", HTTP_GET, []() { serveFsFile("/index.html", "text/html"); });
  serverObj.on("/style.css", HTTP_GET, []() { serveFsFile("/style.css", "text/css"); });
  serverObj.on("/app.js", HTTP_GET, []() { serveFsFile("/app.js", "application/javascript"); });

  // ----- API: Joystick (liên tục) -----
  serverObj.on("/api/joystick", HTTP_GET, []() {
    autonomy.notifyManual();
    ai.notifyUserInput();
    uint8_t axis = (uint8_t)serverObj.arg("axis").toInt();
    if (axis > 1) axis = 0;
    int8_t  v    = (int8_t)constrain(serverObj.arg("v").toInt(), -100, 100);
    head.joystick(axis, v);
    serverObj.send(200, "application/json", "{\"ok\":1}");
  });

  // ----- API: Stop khẩn cấp -----
  serverObj.on("/api/stop", HTTP_GET, []() {
    head.stopAll();
    serverObj.send(200, "application/json", "{\"ok\":1}");
  });

  // ----- API: Center / Nudge -----
  serverObj.on("/api/center", HTTP_GET, []() {
    autonomy.notifyManual();
    head.center();
    serverObj.send(200, "application/json", "{\"ok\":1}");
  });
  serverObj.on("/api/nudge", HTTP_GET, []() {
    autonomy.notifyManual();
    head.setTarget(
      constrain(head.axisPan.targetAngle  + serverObj.arg("dpan").toFloat(),  PAN_MIN_DEG,  PAN_MAX_DEG),
      constrain(head.axisTilt.targetAngle + serverObj.arg("dtilt").toFloat(), TILT_MIN_DEG, TILT_MAX_DEG)
    );
    serverObj.send(200, "application/json", "{\"ok\":1}");
  });

  // ----- API: Emotion / Gesture / Mode -----
  serverObj.on("/api/emotion", HTTP_GET, []() {
    autonomy.notifyManual();
    EmotionType e = (EmotionType)serverObj.arg("id").toInt();
    switch (e) {
      case EMOTION_HAPPY:    gesture.play(GESTURE_BOUNCE_HAPPY); break;
      case EMOTION_SLEEPY:   gesture.play(GESTURE_SLEEP_DROOP);  break;
      case EMOTION_CURIOUS:  gesture.play(GESTURE_TILT_CURIOUS); break;
      case EMOTION_CONFUSED: gesture.play(GESTURE_SHAKE_NO);     break;
      case EMOTION_WAKE_UP:  gesture.play(GESTURE_WAKE_STRETCH); break;
      default: break;
    }
    serverObj.send(200, "application/json", "{\"ok\":1}");
  });
  serverObj.on("/api/gesture", HTTP_GET, []() {
    autonomy.notifyManual();
    gesture.play((GestureId)serverObj.arg("id").toInt());
    serverObj.send(200, "application/json", "{\"ok\":1}");
  });
  serverObj.on("/api/mode", HTTP_GET, []() {
    AutonomyMode m = (AutonomyMode)serverObj.arg("id").toInt();
    autonomy.setMode(m);
    ai.setMode(m);
    serverObj.send(200, "application/json", "{\"ok\":1}");
  });
  serverObj.on("/api/ai", HTTP_GET, []() {
    String a = serverObj.arg("act");
    if      (a == "shy")     ai.setPersonality(AI_PERSONALITY_SHY);
    else if (a == "playful") ai.setPersonality(AI_PERSONALITY_PLAYFUL);
    else if (a == "chill")   ai.setPersonality(AI_PERSONALITY_CHILL);
    serverObj.send(200, "application/json", "{\"ok\":1}");
  });

  // ----- API: State / Info -----
  serverObj.on("/api/state", HTTP_GET, []() {
    JsonDocument d;
    d["pan"]        = round(head.axisPan.currentAngle  - head.axisPan.offset);
    d["tilt"]       = round(head.axisTilt.currentAngle - head.axisTilt.offset);
    d["target_pan"] = round(head.axisPan.targetAngle);
    d["target_tilt"]= round(head.axisTilt.targetAngle);
    d["fps"]        = round(display.actualFps);
    d["moving"]     = head.isMoving();
    d["ai_mode"]    = (int)ai.mode;
    d["personality"]= (int)ai.personality;
    d["mood"]       = ai.mood;
    d["gesture"]    = (int)gesture.currentGesture;
    String s; serializeJson(d, s);
    serverObj.send(200, "application/json", s);
  });

  serverObj.on("/api/info", HTTP_GET, []() {
    JsonDocument d;
    d["fw"]      = FIRMWARE_VERSION;
    d["build"]   = FIRMWARE_BUILD_TIME;
    d["chip"]    = (String)ESP.getChipModel();
    d["cpu_mhz"] = ESP.getCpuFreqMHz();
    d["heap"]    = ESP.getFreeHeap();
    d["psram"]   = ESP.getFreePsram();
    d["ssid"]    = WIFI_AP_SSID;
    d["ip"]      = WiFi.softAPIP().toString();
    d["clients"] = WiFi.softAPgetStationNum();
    String s; serializeJson(d, s);
    serverObj.send(200, "application/json", s);
  });

  // ----- OTA HTTP từ URL -----
  serverObj.on("/api/ota/start", HTTP_GET, []() {
    String url = serverObj.arg("url");
    if (url.length() < 8) { serverObj.send(400, "application/json", "{\"err\":\"url\"}"); return; }
    if (gOta.state != OTA_IDLE && gOta.state != OTA_DONE && gOta.state != OTA_ERROR) {
      serverObj.send(200, "application/json", "{\"busy\":1}"); return;
    }
    gOtaUrl = url;
    gOta = OtaProgress{};
    gOta.state  = OTA_CHECKING;
    gOta.status = "starting";
    serverObj.send(200, "application/json", "{\"ok\":1}");
    xTaskNotifyGive(gOtaTaskHandle);
  });
  serverObj.on("/api/ota/progress", HTTP_GET, sendOtaJson);

  // ----- OTA Upload file trực tiếp (kéo-thả) -----
  serverObj.on("/api/ota/upload", HTTP_POST, []() {
    bool ok = !Update.hasError();
    serverObj.send(200, "text/plain", ok ? "OK" : "FAIL");
    if (ok) { delay(200); ESP.restart(); }
  }, []() {
    HTTPUpload& up = serverObj.upload();
    if (up.status == UPLOAD_FILE_START) {
      Serial0.printf("[OTA] Upload %s\n", up.filename.c_str());
      if (!Update.begin(UPDATE_SIZE_UNKNOWN)) Update.printError(Serial0);
      gOta = OtaProgress{}; gOta.state = OTA_FLASHING; gOta.status = "uploading";
    } else if (up.status == UPLOAD_FILE_WRITE) {
      Update.write(up.buf, up.currentSize);
      gOta.received += up.currentSize;
    } else if (up.status == UPLOAD_FILE_END) {
      if (Update.end(true)) { gOta.state = OTA_DONE; gOta.status = "done"; }
      else                   { gOta.state = OTA_ERROR; gOta.error = "verify fail"; }
    }
  });

  serverObj.onNotFound([]() { serveFsFile("/index.html", "text/html"); });
  serverObj.begin();
}

// =================== SECTION 12: FREERTOS TASKS ===================
void taskWeb(void*) {
  while (true) {
    dnsServerObj.processNextRequest();
    serverObj.handleClient();
    vTaskDelay(pdMS_TO_TICKS(2));
  }
}

void taskDisplay(void*) {
  while (true) {
    display.update();
    vTaskDelay(pdMS_TO_TICKS(4));
  }
}

void taskBrain(void*) {
  TickType_t last = xTaskGetTickCount();
  while (true) {
    ai.tick();
    ai.dispatch();
    gesture.update();
    autonomy.update();
    vTaskDelayUntil(&last, pdMS_TO_TICKS(20)); // 50 Hz
  }
}

void taskMotor(void*) {
  TickType_t last = xTaskGetTickCount();
  while (true) {
    head.update(0.020f);
    vTaskDelayUntil(&last, pdMS_TO_TICKS(20)); // 50 Hz
  }
}

// =================== SECTION 13: SETUP & LOOP ===================
void setup() {
  Serial0.begin(115200);
  Serial.begin(115200);
  delay(200);

  Serial0.println(F("\n================================================="));
  Serial0.println(F("  MIU EILIK ROBOT  -  ESP32-S3  -  v4.0.0-clean   "));
  Serial0.println(F("  2 DC Motors (PAN/TILT) + OLED Eyes + AI Lite    "));
  Serial0.println(F("================================================="));

  gStateMutex = xSemaphoreCreateMutex();

  // LittleFS chứa web UI
  if (!LittleFS.begin(true)) {
    Serial0.println(F("[FS] LittleFS mount FAIL"));
  } else {
    Serial0.println(F("[FS] LittleFS mounted OK"));
  }

  display.begin();
  head.loadOffsets();
  head.begin();
  setupWebServer();

  // Task OTA
  xTaskCreate(otaTaskFn, "ota", 8192, nullptr, 2, &gOtaTaskHandle);

  // Phân bổ 2 core
  xTaskCreatePinnedToCore(taskWeb,     "Web",     4096, nullptr, 3, nullptr, 0);
  xTaskCreatePinnedToCore(taskDisplay, "Display", 4096, nullptr, 4, nullptr, 1);
  xTaskCreatePinnedToCore(taskBrain,   "Brain",   4096, nullptr, 3, nullptr, 1);
  xTaskCreatePinnedToCore(taskMotor,   "Motor",   3072, nullptr, 5, nullptr, 1);

  Serial0.println(F("[SYSTEM] Ready."));
}

unsigned long lastTelemetryMs = 0;
void loop() {
  unsigned long now = millis();
  if (now - lastTelemetryMs > 10000) {
    lastTelemetryMs = now;
    Serial0.printf(
      "[T] up=%lus fps=%.1f heap=%u psram=%u pan=%.1f tilt=%.1f move=%d mood=%.2f\n",
      now/1000, display.actualFps, ESP.getFreeHeap(), ESP.getFreePsram(),
      head.axisPan.currentAngle, head.axisTilt.currentAngle, (int)head.isMoving(), ai.mood
    );
  }
  delay(100);
}
